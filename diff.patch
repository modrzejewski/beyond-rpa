+            VIS_CUBEFILE_SPACING = VOL_SPACING_MEDIUM
+          case ("FINE")
+            VIS_CUBEFILE_SPACING = VOL_SPACING_FINE
+          case default
+            call msg("INVALID CUBE SPACING", MSG_ERROR)
