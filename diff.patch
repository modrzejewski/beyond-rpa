+   subroutine read_scf_saverho(line)
+      character(*), intent(in) :: line
+
+      character(:), allocatable :: keyword, s12, s1, s2
+
+      call split(line, keyword, s12)
+      call split(s12, s1, s2)
+      !
+      ! scf_saverho binary/text file_path
+      !
+      select case (uppercase(s1))
+       case ("TEXT", "RHOA-TEXT")
