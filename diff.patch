+      integer :: IntListLength
+      character(*), intent(in) :: s
+
+      integer :: l, k, i
+      integer :: maxints
+      integer :: t
+      integer :: ios
+
+      l = len_trim(s)
+      IntListLength = 0
+      if (l > 0) then
+         maxints = l / 2 + 1
+         do k = 1, maxints + 1
+            read(s, iostat=ios, fmt=*) (t, i=1, k)
+            if (ios .ne. 0) then
+               IntListLength = k - 1
+               exit
             end if
