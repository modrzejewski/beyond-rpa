+         this%T2AuxOrbitals = RPA_AUX_MOLECULAR_ORBITALS
+         this%ChiOrbitals = RPA_ORBITALS_CANONICAL
+       case (RPA_THEORY_2G)
+         this%T2AuxOrbitals = RPA_AUX_MOLECULAR_ORBITALS
+         this%ChiOrbitals = RPA_ORBITALS_SEMICANONICAL
