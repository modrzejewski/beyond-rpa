+      call readreal(RTTDDFT_POLAR_OMEGA, val)
+
+      do i = 1, size(RTTDDFT_POLAR_OMEGA)
+         if (.not. RTTDDFT_POLAR_OMEGA(i) > ZERO) then
+            call msg("ANGULAR FREQUENCY MUST BE GREATER THAN ZERO", MSG_ERROR)
