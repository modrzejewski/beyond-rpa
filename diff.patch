+      !
+      if (ECP_PARAMS_PATH%get_default() == "") then
+         call ECP_PARAMS_PATH%set_default(BASIS_SET_PATH)
+      end if
+      !
+      ! Default path for ECP parameters will be the file of the basis set parameters
