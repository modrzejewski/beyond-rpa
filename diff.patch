+      ! contain any blanks.
+      !
+      character(len=:), allocatable :: str_i32
+      integer(I32), intent(in) :: i
+
+      character(len=I32_MAXWIDTH) :: t
+      integer :: l
+
+      write(t, "(I0)") i
+      l = len_trim(t)
+      allocate(character(l) :: str_i32)
+      str_i32(:) = t(1:l)
+   end function str_i32
