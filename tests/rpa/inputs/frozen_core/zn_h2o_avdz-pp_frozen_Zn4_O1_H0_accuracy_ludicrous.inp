! test category: fast
! reference values from pyscf
! Frozen orbitals AB/A/B:            5/4/1
! HF single point AB (a.u.):         -301.99412237
! dRPA single point AB (a.u.):       -0.69646140
! HF single point A (a.u.):          -225.95258805
! dRPA single point A (a.u.):        -0.45033160
! HF single point B (a.u.):          -76.04155073
! dRPA single point B (a.u.):        -0.24575949
! HF interaction A...B (kcal/mol):   0.010294
! dRPA interaction A...B (kcal/mol): -0.232376

basis aug-cc-pVDZ-PP

scf
  xcfunc HF
end

rpa
  TheoryLevel RPA+ph
  accuracy ludicrous
  FrozenOrbitals Zn 4
  FrozenOrbitals O 1
  FrozenOrbitals H 0
end

xyz
1 3
Zn      0.000000    0.000000    0.000000
O       3.900000    0.000000    0.000000
H       4.480000    0.760000    0.000000
H       4.480000   -0.760000    0.000000
end
