! test category: fast
! reference values from pyscf
! Frozen orbitals:        2
! HF single point (a.u.): -274.3789324375
! MP2 correlation (a.u.): -0.5659701682

basis_assignment
  Mg cc-repo/cc-pwcvtz
  O  cc-repo/cc-pwcvtz
end

scf
  xcfunc HF
  eri_algorithm thc
  lindepthresh 1.0E-5
end

rpa
  TheoryLevel RPA+ph
  !
  ! The default profile with QRThresh post-scf 1.0E-4 and choleskytauthresh
  ! 1.0E-6. δSemicore is a small difference of large correlation
  ! energies, so the THC pivot noise of the correlation stage must be
  ! low, and the Cholesky threshold keeps the Coulomb integrals below
  ! that noise.
  !
  accuracy custom
  choleskytauthresh 1.0E-6
  FrozenOrbitals Mg 1
  FrozenOrbitals O 1
  PT2
end

thc
  QRThresh scf 1.0E-4
  QRThresh post-scf 1.0E-4
end

! PBE0/def2-TZVP equilibrium geometry
xyz
2
Mg     0.00000000000    0.00000000000    0.00000000000
O      0.00000000000    0.00000000000    1.73276600000
end
