! test category: fast
! reference values from pyscf
! Frozen orbitals:        6
! HF single point (a.u.): -547.3131685578
! MP2 correlation (a.u.): -0.7085695425

basis_assignment
  S  cc-repo/cc-pvqz
  O  cc-repo/cc-pvqz
end

scf
  xcfunc HF
  eri_algorithm thc
  lindepthresh 1.0E-5
end

rpa
  TheoryLevel RPA+ph
  !
  ! The default profile with QRThresh post-scf 1.0E-4 and choleskytauthresh
  ! 1.0E-6. δSemicore is a small difference of large correlation
  ! energies, so the THC pivot noise of the correlation stage must be
  ! low, and the Cholesky threshold keeps the Coulomb integrals below
  ! that noise.
  !
  accuracy custom
  choleskytauthresh 1.0E-6
  FrozenOrbitals S 5
  FrozenOrbitals O 1
  PT2
end

thc
  QRThresh scf 1.0E-4
  QRThresh post-scf 1.0E-4
end

! PBE0/def2-TZVP equilibrium geometry
xyz
3
S      0.00000000000    0.00000000000    0.00000000000
O      1.23259200000    0.00000000000    0.72753200000
O     -1.23259200000    0.00000000000    0.72753200000
end
