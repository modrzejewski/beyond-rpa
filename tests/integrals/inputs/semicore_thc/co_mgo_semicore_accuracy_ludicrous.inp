! test category: slow
! reference values from pyscf
! Frozen orbitals AB/A/B:                       4/2/2
! HF single point AB (a.u.):                    -387.1705124987
! MP2 correlation AB (a.u.):                    -0.9322054334
! HF single point A (a.u.):                     -112.7786649950
! MP2 correlation A (a.u.):                     -0.3642413373
! HF single point B (a.u.):                     -274.3828788001
! MP2 correlation B (a.u.):                     -0.5696905755
! HF interaction A...B (kcal/mol):              -5.62794642
! MP2 correlation interaction A...B (kcal/mol): 1.08338214

basis_assignment
  C  cc-repo/aug-cc-pvtz
  Mg cc-repo/cc-pwcvtz
  O  cc-repo/aug-cc-pvtz
end

scf
  xcfunc HF
end

rpa
  TheoryLevel RPA+ph
  accuracy ludicrous
  FrozenOrbitals C 1
  FrozenOrbitals Mg 1
  FrozenOrbitals O 1
  ! The ludicrous baseline keeps the default THC grid (SG-1),
  ! which limits the accuracy; we upgrade it to medium.
  THC_BeckeGridKind medium
  PT2
end

xyz
2 2
charges 0 0
C      0.00000000000    0.00000000000    2.44102235837
O      0.00000000000    0.00000000000    3.58784217303
Mg     0.00000000000    0.00000000000    0.00000000000
O      0.00000000000    0.00000000000   -1.74900000000
end
