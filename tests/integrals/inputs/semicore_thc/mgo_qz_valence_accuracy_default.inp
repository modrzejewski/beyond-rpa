! test category: fast
! reference values from pyscf
! Frozen orbitals:        6
! HF single point (a.u.): -274.3852740048
! MP2 correlation (a.u.): -0.3489653377

basis_assignment
  Mg cc-repo/cc-pvqz
  O  cc-repo/cc-pvqz
end

scf
  xcfunc HF
  eri_algorithm thc
  lindepthresh 1.0E-5
  thc_qrthresh 1.0E-4
end

rpa
  TheoryLevel RPA+ph
  !
  ! The default profile with THC_QRThresh 1.0E-4 and choleskytauthresh
  ! 1.0E-6. δSemicore is a small difference of large correlation
  ! energies, so the THC pivot noise of the correlation stage must be
  ! low, and the Cholesky threshold keeps the Coulomb integrals below
  ! that noise.
  !
  accuracy custom
  THC_QRThresh 1.0E-4
  choleskytauthresh 1.0E-6
  FrozenOrbitals Mg 5
  FrozenOrbitals O 1
  PT2
end

! PBE0/def2-TZVP equilibrium geometry
xyz
2
Mg     0.00000000000    0.00000000000    0.00000000000
O      0.00000000000    0.00000000000    1.73276600000
end
