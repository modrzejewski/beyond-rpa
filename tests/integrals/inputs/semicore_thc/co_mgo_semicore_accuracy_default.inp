! test category: fast
! reference values from pyscf
! Frozen orbitals AB/A/B:                       4/2/2
! HF single point AB (a.u.):                    -387.1756160482
! MP2 correlation AB (a.u.):                    -0.9257090433
! HF single point A (a.u.):                     -112.7825165242
! MP2 correlation A (a.u.):                     -0.3598380901
! HF single point B (a.u.):                     -274.3832682516
! MP2 correlation B (a.u.):                     -0.5694056629
! HF interaction A...B (kcal/mol):              -6.16921656
! MP2 correlation interaction A...B (kcal/mol): 2.21806382

basis_assignment
  C  cc-repo/aug-cc-pvtz
  Mg cc-repo/cc-pwcvtz
  O  cc-repo/aug-cc-pvtz
end

scf
  xcfunc HF
  eri_algorithm thc
  lindepthresh 1.0E-5
  thc_qrthresh 1.0E-4
end

rpa
  TheoryLevel RPA+ph
  !
  ! The default profile with a tighter Cholesky threshold of the Coulomb
  ! integrals. That threshold sets the noise floor of the correlation
  ! energy: the semicore pair energies are large and the interaction
  ! energy is a small difference of them. At the default 1.0E-5 the
  ! noise is a few 1E-3 kcal/mol and no THC threshold lowers it; at
  ! 1.0E-6 it is below 1E-3 kcal/mol at the same cost.
  !
  accuracy custom
  THC_QRThresh 1.0E-3
  choleskytauthresh 1.0E-6
  FrozenOrbitals C 1
  FrozenOrbitals Mg 1
  FrozenOrbitals O 1
  PT2
end

xyz
2 2
charges 0 0
C      0.00000000000    0.00000000000    2.32028900000
O      0.00000000000    0.00000000000    3.44057500000
Mg     0.00000000000    0.00000000000    0.00000000000
O      0.00000000000    0.00000000000   -1.73209300000
end
